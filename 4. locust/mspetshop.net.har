            "text": "#launcher-fab .ui-layout-row{padding-bottom:2rem}#launcher-fab .ui-layout-row .ui-button{border-radius:12px}#launcher-fab,#launcher-minimal{bottom:0;position:absolute;z-index:0}body.left #launcher-fab,body.left #launcher-minimal{left:0}body.right #launcher-fab,body.right #launcher-minimal{right:0}.away-form-scroll-container{-webkit-box-flex:1;-ms-flex:1;flex:1}.away-form-scroll-container .messenger-away-form{display:grid;grid-template-rows:-webkit-max-content 1fr -webkit-max-content;grid-template-rows:max-content 1fr max-content;min-height:100%}.away-form-scroll-container .messenger-away-form .away-thanks{display:grid;grid-template-rows:repeat(2,-webkit-max-content);grid-template-rows:repeat(2,max-content);grid-template-columns:15rem;-webkit-box-pack:center;-ms-flex-pack:center;justify-content:center;justify-items:center;-ms-flex-line-pack:center;align-content:center;grid-row-gap:.8rem}#page-conversation{display:grid;min-height:0;min-width:0;position:relative;-webkit-box-flex:1;-ms-flex:1;flex:1}#page-conversation .ui-conversation-stream{height:100%}#page-conversation .ui-conversation-stream .history{margin-bottom:2rem}#page-conversation .ui-conversation-stream .blocked{padding:2rem 0}#page-conversation .ui-conversation-stream .blocked .ui-text{margin-left:.8rem}#page-conversation .ui-conversation-stream .offline{margin:1.6rem 0}#page-conversation .ui-conversation-compose{position:absolute;bottom:0;left:0;right:0;z-index:1}#page-conversation .powered-by-button{position:absolute;top:1.6rem;right:1.6rem}#page-conversation .waiting{padding:1.6rem;padding-left:4rem;padding-right:4rem;text-align:center}#page-conversation .ui-file-upload{overflow:hidden}#page-conversation .ui-file-upload .dragging-zone{overflow:hidden;padding-bottom:58px;min-height:0;height:100%}#page-history{height:100%;position:relative}#page-history ul{padding-top:1.2rem}.ui-avatar-header.team-header .content .title{font-size:1.6rem}.ui-messenger-layout .primary-fab{bottom:1.6rem;position:absolute;right:1.6rem;z-index:1}#notifications{position:absolute;bottom:0;right:0}#notifications .ui-messenger-notification+.ui-messenger-notification{margin-top:.8rem}#launcher-fab~#notifications{margin-bottom:56px;padding-bottom:1.6rem}#launcher-minimal~#notifications{padding-bottom:1.6rem}#announcements{padding-bottom:2rem}#announcements,#invites{position:absolute;bottom:0;right:0;z-index:99}#launcher-fab~#invites{margin-bottom:56px;padding-bottom:1.6rem}#launcher-minimal~#invites{padding-bottom:1.6rem}.phone>#launcher-fab~#invites{margin-bottom:40px}#surveys{-webkit-box-align:end;-ms-flex-align:end;align-items:flex-end;bottom:0;display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-orient:vertical;-webkit-box-direction:normal;-ms-flex-direction:column;flex-direction:column;position:absolute;right:0;z-index:99;padding-bottom:2rem}body,html{height:100%;width:100%}body{background:transparent!important;display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-orient:vertical;-webkit-box-direction:normal;-ms-flex-direction:column;flex-direction:column;overflow:hidden;padding-top:2rem}body.left{-webkit-box-align:start;-ms-flex-align:start;align-items:flex-start;-webkit-box-pack:start;-ms-flex-pack:start;justify-content:flex-start;padding-right:1.6rem}body.right{-webkit-box-align:end;-ms-flex-align:end;align-items:flex-end;-webkit-box-pack:end;-ms-flex-pack:end;justify-content:flex-end;padding-left:1.6rem}body.phone{padding:2rem 1.6rem 1.6rem}body.phone .ui-messenger-layout{border-radius:0;position:fixed;top:0;left:0}#lucky-orange-app{position:relative;height:100%;width:100%}#lucky-orange-app.phone{padding:0}.vue-wrapper{display:none}.file-message .image-container{position:relative}.file-message .image-container .image-overlay{position:absolute;width:100%;height:100%;display:none;cursor:pointer}.file-message .image-container:hover .image-overlay{display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-pack:center;-ms-flex-pack:center;justify-content:center;-webkit-box-align:center;-ms-flex-align:center;align-items:center}.file-message .image-container:hover .image-overlay:after{content:\"\";position:absolute;height:100%;width:100%;background:-webkit-gradient(linear,left bottom,right top,from(#3d4143),to(#4567b0));background:linear-gradient(to right top,#3d4143 0,#4567b0);opacity:.75;border-radius:12px}.file-message .image-container:hover .image-overlay .ui-icon{color:#fefefe;z-index:1}.file-message .image-container img{border-radius:12px}.file-message .buttons{margin-top:1.2rem;display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-pack:end;-ms-flex-pack:end;justify-content:flex-end}.file-message .vertical-divider{height:2.4rem;width:.2rem;display:inline-block;background-color:#f8f8f7;margin:0 1.2rem}.image-takeover>.content{height:100%;display:grid;grid-template-rows:-webkit-max-content 1fr;grid-template-rows:max-content 1fr;-webkit-box-pack:center;-ms-flex-pack:center;justify-content:center;text-align:center}.image-takeover>.content p{margin:2rem}.image-takeover>.content img{max-width:968px;-webkit-box-shadow:0 10px 40px rgba(61,65,67,.2);box-shadow:0 10px 40px rgba(61,65,67,.2);-ms-flex-item-align:center;align-self:center}.ui-conversation-message.ratingRequest .message{width:100%}.ui-conversation-message.ratingRequest #rating-request .choices{display:-webkit-box;display:-ms-flexbox;display:flex;-webkit-box-pack:justify;-ms-flex-pack:justify;justify-content:space-between}.powered-by-button{-webkit-filter:grayscale(1);filter:grayscale(1);opacity:.6;-webkit-transition:all .3s cubic-bezier(.2,.1,.2,1);transition:all .3s cubic-bezier(.2,.1,.2,1)}.powered-by-button:focus,.powered-by-button:focus-within,.powered-by-button:hover{-webkit-filter:none;filter:none;opacity:1}"
